# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=preconnect_db
DB_USER=root
DB_PASSWORD=

# Session Security Configuration
SESSION_SLIDING_EXPIRY_DAYS=7
SESSION_ABSOLUTE_EXPIRY_DAYS=30

# Booking & Payment Configuration
# PAYMENT_MODE: "worldline" (customers pay on Worldline's hosted page) or "disabled"
PAYMENT_MODE=worldline
# Consultation fee in paise (99900 = Rs 999.00)
CONSULTATION_FEE_PAISE=99900

# Public base URL of the site. Used in PRODUCTION for payment gateway return URLs.
# In development the current request origin is used, so any port works.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Worldline Connect (server API). Sandbox/pre-production: api.preprod.connect.worldline-solutions.com
# Production: api.connect.worldline-solutions.com  (India/TechProcess accounts: api.india[.preprod].connect...)
WORLDLINE_BASE_URL=https://api.preprod.connect.worldline-solutions.com
WORLDLINE_MERCHANT_ID=
WORLDLINE_API_KEY_ID=
WORLDLINE_SECRET_API_KEY=

# Optional: public base URL the payment gateway sends customers back to (e.g. an ngrok URL).
# Dev default: localhost is replaced by localtest.me, because Worldline rejects "localhost" return URLs.
# PAYMENT_RETURN_BASE_URL=
# Hosted payment page subdomain (Configuration Center → Hosted payment pages → Subdomains). Default: payment
# WORLDLINE_CHECKOUT_SUBDOMAIN=payment

# Encrypts secrets stored in the database (e.g. the SMTP password, Google tokens), AES-256-GCM.
# 64 hex characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and stable — changing it makes saved secrets unreadable (re-enter them in the admin portal).
SETTINGS_ENCRYPTION_KEY=

# Google Calendar & Meet Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
